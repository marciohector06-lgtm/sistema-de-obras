# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Gemini (Fase 6)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Automações via E-mail (Fase 9) - chave usada para criptografar a senha IMAP salva no banco
EMAIL_CREDENTIALS_SECRET=

# Rate limiting distribuído (Fase 10) - opcional; sem isso, cai para um limitador em memória (só vale para 1 instância)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME="Fornax Engenharia"
NEXT_PUBLIC_APP_URL=http://localhost:3000
