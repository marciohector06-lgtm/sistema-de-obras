// Schema do banco de dados - Sistema de Gestão de Obras

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== USUARIOS =====
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  role         Role       @default(VIEWER)
  status       UserStatus @default(PENDING)
  avatar       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  gastos          Gasto[]
  pagamentos      Pagamento[]
  createdObras    Obra[]           @relation("CreatedBy")
  createdPropostas Proposta[]      @relation("PropostaCreatedBy")
  propostaEventos PropostaEvento[]
}

enum Role {
  ADMIN
  GESTOR
  ENGENHEIRO
  VIEWER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// ===== CLIENTES =====
model Cliente {
  id        String   @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  cpfCnpj   String?
  endereco  String?
  createdAt DateTime @default(now())

  obras     Obra[]
  propostas Proposta[]
}

// ===== OBRAS =====
model Obra {
  id              String           @id @default(cuid())
  nome            String
  descricao       String?
  clienteId       String?
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  endereco        String?
  valorContrato   Decimal          @db.Decimal(12, 2)
  dataInicio      DateTime
  dataTermino     DateTime
  status          ObraStatus       @default(EM_ANDAMENTO)
  prioridade      Prioridade       @default(MEDIA)
  progresso       Decimal          @default(0) @db.Decimal(5, 2)
  cor             String           @default("#1565C0")
  createdById     String?
  createdBy       User?            @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  previsaoCusto         Decimal?  @db.Decimal(12, 2)
  previsaoJustificativa String?
  previsaoAtualizadaEm  DateTime?

  gastos          Gasto[]
  entradas        Entrada[]
  pagamentos      Pagamento[]
  inventarioItens ObraInventario[]
  alertas         Alerta[]
  contratos       Contrato[]
  movimentos      MovimentoFinanceiro[]
}

enum ObraStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

// ===== GASTOS =====
model Gasto {
  id          String         @id @default(cuid())
  obraId      String
  obra        Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  descricao   String
  categoria   GastoCategoria
  valor       Decimal        @db.Decimal(12, 2)
  data        DateTime
  comprovante String?
  observacao  String?
  createdAt   DateTime       @default(now())
}

enum GastoCategoria {
  MATERIAL
  MAO_DE_OBRA
  EQUIPAMENTO
  CONTRATO
  ADMINISTRATIVO
  OUTRO
}

// ===== ENTRADAS (receitas recebidas do cliente contra o contrato) =====
model Entrada {
  id          String   @id @default(cuid())
  obraId      String
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  data        DateTime
  comprovante String?
  observacao  String?
  createdAt   DateTime @default(now())
}

// ===== INVENTARIO =====
model ItemInventario {
  id            String   @id @default(cuid())
  nome          String
  unidade       String
  valorUnitario Decimal  @db.Decimal(10, 2)
  estoqueMinimo Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  obraItens     ObraInventario[]
}

model ObraInventario {
  id          String         @id @default(cuid())
  obraId      String
  obra        Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  itemId      String
  item        ItemInventario @relation(fields: [itemId], references: [id])
  qtdComprada Int
  qtdUsada    Int            @default(0)
  local       String?
  updatedAt   DateTime       @updatedAt

  @@unique([obraId, itemId])
}

// ===== PAGAMENTOS =====
model Pagamento {
  id             String          @id @default(cuid())
  obraId         String
  obra           Obra            @relation(fields: [obraId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  prestadorId    String?
  prestador      Prestador?      @relation(fields: [prestadorId], references: [id])
  descricao      String
  valor          Decimal         @db.Decimal(12, 2)
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         PagamentoStatus @default(PENDENTE)
  comprovante    String?
  observacao     String?
  createdAt      DateTime        @default(now())
}

enum PagamentoStatus {
  PENDENTE
  EFETUADO
  EM_PROCESSAMENTO
  ATRASADO
  CANCELADO
}

// ===== CONTRATOS =====
model Contrato {
  id        String    @id @default(cuid())
  obraId    String
  obra      Obra      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  titulo    String
  arquivo   String?
  valor     Decimal?  @db.Decimal(12, 2)
  dataAssin DateTime?
  createdAt DateTime  @default(now())
}

// ===== ALERTAS (gerados pela IA) =====
model Alerta {
  id        String     @id @default(cuid())
  obraId    String?
  obra      Obra?      @relation(fields: [obraId], references: [id], onDelete: Cascade)
  tipo      AlertaTipo
  titulo    String
  mensagem  String
  lido      Boolean    @default(false)
  createdAt DateTime   @default(now())
}

enum AlertaTipo {
  ORCAMENTO_70
  ORCAMENTO_85
  ORCAMENTO_100
  ORCAMENTO_ESTOURADO
  PRAZO_VENCIDO
  PRAZO_PROXIMO
  ESTOQUE_BAIXO
  DADOS_INCONSISTENTES
  IA_PREVISAO
}

// ===== MATERIAIS =====
model Material {
  id        String   @id @default(cuid())
  descricao String
  unidade   String
  preco     Decimal  @db.Decimal(12, 2)
  ncm       String?
  origem    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propostaItens PropostaItem[]
}

// ===== PROPOSTAS/ORCAMENTOS =====
model Proposta {
  id            String          @id @default(cuid())
  numero        Int             @unique @default(autoincrement())
  titulo        String
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  status        PropostaStatus  @default(ATIVA)
  bdi           Decimal         @default(0) @db.Decimal(6, 2)
  impostos      Decimal         @default(0) @db.Decimal(6, 2)
  observacao    String?
  createdById   String?
  createdBy     User?           @relation("PropostaCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  secoes        PropostaSecao[]
  eventos       PropostaEvento[]
}

enum PropostaStatus {
  ATIVA
  APROVADA
  REJEITADA
}

model PropostaSecao {
  id         String   @id @default(cuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  titulo     String
  ordem      Int      @default(0)

  itens      PropostaItem[]
}

model PropostaItem {
  id            String         @id @default(cuid())
  secaoId       String
  secao         PropostaSecao  @relation(fields: [secaoId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material?      @relation(fields: [materialId], references: [id])
  descricao     String
  unidade       String
  quantidade    Decimal        @db.Decimal(12, 3)
  precoUnitario Decimal        @db.Decimal(12, 2)
  ordem         Int            @default(0)
}

model PropostaEvento {
  id         String         @id @default(cuid())
  propostaId String
  proposta   Proposta       @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  tipo       PropostaEventoTipo
  mensagem   String
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
}

enum PropostaEventoTipo {
  CRIADA
  EDITADA
  STATUS_ALTERADO
}

// ===== PRESTADORES & FINANCEIRO UNIFICADO =====
model Prestador {
  id        String   @id @default(cuid())
  nome      String
  documento String?
  chavePix  String?
  categoria String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contratos  ContratoPrestador[]
  pagamentos Pagamento[]
  movimentos MovimentoFinanceiro[]
}

model ContratoPrestador {
  id          String    @id @default(cuid())
  prestadorId String
  prestador   Prestador @relation(fields: [prestadorId], references: [id])
  titulo      String
  arquivo     String?
  valor       Decimal?  @db.Decimal(12, 2)
  dataAssin   DateTime?
  createdAt   DateTime  @default(now())
}

model MovimentoFinanceiro {
  id          String        @id @default(cuid())
  tipo        MovimentoTipo
  descricao   String
  valor       Decimal       @db.Decimal(12, 2)
  data        DateTime
  categoria   String?
  obraId      String?
  obra        Obra?         @relation(fields: [obraId], references: [id], onDelete: SetNull)
  prestadorId String?
  prestador   Prestador?    @relation(fields: [prestadorId], references: [id])
  createdAt   DateTime      @default(now())
}

enum MovimentoTipo {
  ENTRADA
  SAIDA
}

// ===== AUTOMACOES VIA E-MAIL =====
model ConfiguracaoEmail {
  id                  String    @id @default("config")
  host                String
  porta               Int       @default(993)
  usuario             String
  senhaCriptografada  String
  usarSsl             Boolean   @default(true)
  ativo               Boolean   @default(false)
  ultimaVerificacaoEm DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ImportacaoEmailLog {
  id                   String                @id @default(cuid())
  tipo                 ImportacaoEmailTipo
  status               ImportacaoEmailStatus
  mensagem             String
  quantidadeProcessada Int                    @default(0)
  createdAt            DateTime               @default(now())
}

enum ImportacaoEmailTipo {
  NFE
  PIX_INTER
  GERAL
}

enum ImportacaoEmailStatus {
  SUCESSO
  ERRO
}

// ===== AUDITORIA =====
model AuditLog {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String
  userId     String?
  userEmail  String?
  detalhes   Json?
  createdAt  DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([userId])
}
